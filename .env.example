# Шаблон для Droplet. Локальний .env не копіювати звідси сліпо:
# локальний venv — DJANGO_SETTINGS_MODULE=config.settings (SQLite).

SECRET_KEY=change-me-in-production
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.docker

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=strong-password
DB_HOST=db
DB_PORT=5432

# Дописати IPv4 дроплета або домен. Не лишати літерал DROPLET_IP.
ALLOWED_HOSTS=127.0.0.1,localhost,backend
# Після HTTPS: https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=

# false — перший HTTP-захід; true — після certbot.
USE_HTTPS=false
ADMIN_URL=manage

# Секрет підпису вебхука оплати. Порожній — вебхук відхиляє запити (fail-closed).
PAYMENT_WEBHOOK_SECRET=
# Онлайн-оплата карткою. False, доки не підключено LiqPay: картка = звичайне замовлення.
PAYMENT_ONLINE_ENABLED=False
# Ключі LiqPay. Поки не використовуються, лише під майбутню інтеграцію.
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# Довідник відділень Нової пошти працює і без ключа.
# Ключ з Бізнес-кабінету знадобиться пізніше для ТТН. Ніколи не комітити справжній ключ.
NOVA_POSHTA_API_KEY=
